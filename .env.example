NODE_ENV=development
APP_NAME=G-SIPRO
APP_VERSION=0.1.0
LOG_LEVEL=info
DATABASE_URL=postgresql://gsipro:change-me@localhost:5432/gsipro?schema=public
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
TEAMS_CATALOG_APP_ID=
MICROSOFT_GRAPH_TIMEOUT_MS=20000
NOTIFICATION_DISPATCH_TOKEN=
# Preferível: cadastrar em Administrador > E-mail remetente das notificações
# (só o proprietário pode alterar). Esta variável só é usada como retaguarda,
# caso ninguém tenha configurado o valor pela tela ainda.
NOTIFICATION_EMAIL_SENDER=
AZURE_MAPS_CLIENT_ID=
AZURE_MAPS_SUBSCRIPTION_KEY=
AZURE_MAPS_TIMEOUT_MS=30000
# API climática para o estudo de praticabilidade: usa a Open-Meteo (gratuita,
# sem cadastro nem chave) por padrão. Só preencha CLIMATE_API_BASE_URL se
# quiser trocar para outro provedor compatível com o mesmo contrato.
CLIMATE_API_BASE_URL=
CLIMATE_API_HISTORY_YEARS=20
CLIMATE_API_TIMEOUT_MS=30000
AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_REQUEST_TIMEOUT_MS=120000
# Central IA: servidor FastAPI + Ollama local para triagem/esclarecimento de
# suporte (substitui a OpenAI nesses dois pontos). Ver central-ia/README.md.
CENTRAL_IA_BASE_URL=http://localhost:8000
CENTRAL_IA_REQUEST_TIMEOUT_MS=120000
# Obrigatório quando CENTRAL_IA_BASE_URL apontar para um endereço exposto
# publicamente (ex.: túnel). Deixe vazio só para uso 100% local.
CENTRAL_IA_API_TOKEN=
SUPPORT_EXECUTOR_TOKEN=
AUTH_URL=http://localhost:3001
