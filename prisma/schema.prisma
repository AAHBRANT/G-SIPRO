  changedBy     User           @relation("DeadlineChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  correlationId String         @db.Uuid

  @@unique([deadlineId, version])
  @@index([changedById, changedAt])
  @@index([correlationId])
  @@map("deadline_history")
}

model TenderAttachment {
  id              String        @id @default(uuid()) @db.Uuid
  tenderVersionId String        @db.Uuid
  tenderVersion   TenderVersion @relation(fields: [tenderVersionId], references: [id], onDelete: Restrict)
  fileName        String        @db.VarChar(255)
  fileHash        String        @db.Char(64)
  source          String        @db.VarChar(500)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  createdBy       String        @db.Uuid

  @@unique([tenderVersionId, fileHash])
  @@map("tender_attachments")
}

model OpportunityHistory {
  id            String             @id @default(uuid()) @db.Uuid
  opportunityId String             @db.Uuid
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  version       Int
  action        String             @db.VarChar(80)
  fromStatus    OpportunityStatus?
  toStatus      OpportunityStatus
  changes       Json
  reason        String?            @db.VarChar(1000)
  changedAt     DateTime           @default(now()) @db.Timestamptz(6)
  changedById   String             @db.Uuid
  changedBy     User               @relation("OpportunityChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  correlationId String             @db.Uuid

  @@unique([opportunityId, version])
  @@index([changedById, changedAt])
  @@index([correlationId])
  @@map("opportunity_history")
}

model Profile {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique @db.VarChar(80)
  name        String              @db.VarChar(160)
  description String?             @db.VarChar(500)
  active      Boolean             @default(true)
  memberships UserProfile[]
  permissions ProfilePermission[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  createdBy   String              @db.Uuid
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  updatedBy   String              @db.Uuid

  @@index([active])
  @@map("profiles")
}

model Permission {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique @db.VarChar(120)
  module      String              @db.VarChar(80)
  action      String              @db.VarChar(80)
  description String?             @db.VarChar(500)
  profiles    ProfilePermission[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  createdBy   String              @db.Uuid

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model UserProfile {
  userId    String    @db.Uuid
  profileId String    @db.Uuid
  validFrom DateTime  @default(now()) @db.Timestamptz(6)
  validTo   DateTime? @db.Timestamptz(6)
  grantedAt DateTime  @default(now()) @db.Timestamptz(6)
  grantedBy String    @db.Uuid
  reason    String    @db.VarChar(500)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@id([userId, profileId])
  @@index([profileId, validTo])
  @@map("user_profiles")
}

model ProfilePermission {
  profileId    String     @db.Uuid
  permissionId String     @db.Uuid
  grantedAt    DateTime   @default(now()) @db.Timestamptz(6)
  grantedBy    String     @db.Uuid
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([profileId, permissionId])
  @@index([permissionId])
  @@map("profile_permissions")
}

model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  occurredAt    DateTime       @default(now()) @db.Timestamptz(6)
  actorType     AuditActorType
  actorId       String         @db.VarChar(160)
  action        String         @db.VarChar(120)
  entityType    String         @db.VarChar(120)
  entityId      String?        @db.VarChar(160)
  correlationId String         @db.Uuid
  outcome       AuditOutcome
  origin        String         @db.VarChar(160)
  metadata      Json?

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}

model SupportTicket {
  id                    String                    @id @default(uuid()) @db.Uuid
  number                Int                       @unique @default(autoincrement())
  type                  SupportTicketType
  priority              SupportTicketPriority     @default(NORMAL)
  status                SupportTicketStatus       @default(OPEN)
  title                 String                    @db.VarChar(200)
  description           String                    @db.Text
  pagePath              String?                   @db.VarChar(500)
  errorMessage          String?                   @db.Text
  stepsToReproduce      String?                   @db.Text
  clientContext         Json?
  aiDiagnosis           Json?
  aiProviderModel       String?                   @db.VarChar(160)
  aiDiagnosedAt         DateTime?                 @db.Timestamptz(6)
  approvalRequired      Boolean                   @default(false)
  approvalReason        String?                   @db.VarChar(1000)
  reporterId            String                    @db.Uuid
  reporter              User                      @relation("SupportReportedBy", fields: [reporterId], references: [id], onDelete: Restrict)
  assignedToId          String?                   @db.Uuid
  assignedTo            User?                     @relation("SupportAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  resolution            String?                   @db.Text
  resolvedAt            DateTime?                 @db.Timestamptz(6)
  resolvedById          String?                   @db.Uuid
  resolvedBy            User?                     @relation("SupportResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  executionLeaseId      String?                   @unique @db.Uuid
  executorId            String?                   @db.VarChar(160)
  executionClaimedAt    DateTime?                 @db.Timestamptz(6)
  executionHeartbeatAt  DateTime?                 @db.Timestamptz(6)
  executionAttempts     Int                       @default(0)
  resolutionAttempts    Int                       @default(0)
  validationRequestedAt DateTime?                 @db.Timestamptz(6)
  validationQuestions   Json?
  externalBlocker       Json?
  ownerActionRequiredAt DateTime?                 @db.Timestamptz(6)
  escalatedAt           DateTime?                 @db.Timestamptz(6)
  correlationId         String                    @db.Uuid
  attachments           SupportTicketAttachment[]
  decisions             SupportTicketDecision[]
  updates               SupportTicketUpdate[]
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(6)

  @@index([status, priority, createdAt])
  @@index([reporterId, createdAt])
  @@index([approvalRequired, status])
  @@index([correlationId])
  @@map("support_tickets")
}

model SupportTicketAttachment {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  fileName  String        @db.VarChar(255)
  fileHash  String        @db.Char(64)
  mimeType  String        @db.VarChar(160)
  sizeBytes BigInt
  uri       String        @db.VarChar(1000)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  createdBy String        @db.Uuid

  @@unique([ticketId, fileHash])
  @@index([fileHash])
  @@map("support_ticket_attachments")
}

model SupportTicketDecision {
  id          String          @id @default(uuid()) @db.Uuid
  ticketId    String          @db.Uuid
  ticket      SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  decision    SupportDecision
  note        String          @db.VarChar(1000)
  decidedAt   DateTime        @default(now()) @db.Timestamptz(6)
  decidedById String          @db.Uuid
  decidedBy   User            @relation("SupportDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([ticketId, decidedAt])
  @@index([decidedById, decidedAt])
  @@map("support_ticket_decisions")
}

model SupportTicketUpdate {
  id          String               @id @default(uuid()) @db.Uuid
  ticketId    String               @db.Uuid
  ticket      SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  fromStatus  SupportTicketStatus?
  toStatus    SupportTicketStatus
  note        String               @db.VarChar(2000)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  createdById String?              @db.Uuid
  createdBy   User?                @relation("SupportUpdatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  actorLabel  String               @default("Usuário") @db.VarChar(160)

  @@index([ticketId, createdAt])
  @@index([createdById, createdAt])
  @@map("support_ticket_updates")
}
