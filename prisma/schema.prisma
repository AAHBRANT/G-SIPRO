generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TeamsProvisioningStatus {
  NOT_CONFIGURED
  PENDING
  INSTALLED
  FAILED
}

enum IntelligenceNotificationType {
  ANALYSIS_COMPLETED
  RECOMMENDATION_CHANGED
  INFORMATION_REQUESTED
  IMPEDIMENT_DETECTED
  OWNER_DECISION_REQUIRED
  DECISION_RECORDED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  PARTIAL
  FAILED
}

enum NotificationChannel {
  PANEL
  TEAMS
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  ACCEPTED
  SKIPPED
  RETRY
  FAILED
}

enum UserAccessRequestAction {
  CREATE
  UPDATE
}

enum UserAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditActorType {
  USER
  APPLICATION
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum SupportTicketType {
  BUG
  QUESTION
  IMPROVEMENT
  NEW_FEATURE
}

enum SupportTicketPriority {
  NORMAL
  HIGH
  CRITICAL
}

enum SupportTicketStatus {
  OPEN
  TRIAGED
  WAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  WAITING_USER_VALIDATION
  OWNER_ACTION_REQUIRED
  ESCALATED
  RESOLVED
  REJECTED
  CANCELLED
}

enum SupportDecision {
  APPROVED
  REJECTED
}

enum OpportunityOrigin {
  CHANNEL
  REFERRAL
  PORTAL
  CUSTOMER
  PROSPECTING
}

enum OpportunityStatus {
  DRAFT
  QUALIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TenderVersionStatus {
  RECEIVED
  IN_ANALYSIS
  VALIDATED
  SUBSTITUTED
}

enum RequirementCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  REJECTED
}

enum DeadlineStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum CalendarEventStatus {
  SCHEDULED
  CANCELLED
}

enum CalendarEventCategory {
  MEETING
  TRAVEL
  INTERNAL_DEADLINE
  PERSONAL
  OTHER
}

enum DeadlineAlertStatus {
  SCHEDULED
  ACKNOWLEDGED
  CANCELLED
}

enum AnalysisCompetence {
  TECHNICAL
  LEGAL
  COMMERCIAL
  FINANCIAL
  ACCOUNTING
}

enum AnalysisPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AnalysisStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum TechnicalExperienceStatus {
  DRAFT
  VALIDATED
  RESTRICTED
  EXPIRED
}

enum TechnicalEvidenceType {
  ATTESTATION
  CAT
  ART
}

enum TechnicalEvidenceStatus {
  CURRENT
  RESTRICTED
  EXPIRED
}

enum ProfessionalStatus {
  ACTIVE
  INACTIVE
  RESTRICTED
}

enum ProfessionalLinkTargetType {
  CONTRACT
  WORK
  TECHNICAL_EVIDENCE
}

enum ComplianceMatrixStatus {
  IN_ANALYSIS
  VALIDATED
  SUPERSEDED
}

enum ComplianceItemDecision {
  MEETS
  PARTIAL
  DOES_NOT_MEET
  NOT_APPLICABLE
}

enum ProposalStatus {
  PREPARATION
  REVIEW
  APPROVAL
  SENT
  JUDGED
  CLOSED
  FINALIZED
  CANCELLED
}

enum ProposalOriginType {
  PUBLIC_TENDER
  PRIVATE_COMPETITION
  DIRECT
}

enum ProposalComponentType {
  TECHNICAL
  COMMERCIAL
}

enum ProposalComponentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

enum ProposalTechnicalSectionStatus {
  DRAFT
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum ProposalTechnicalCommentSeverity {
  NORMAL
  CRITICAL
}

enum ProposalTechnicalCommentStatus {
  OPEN
  RESOLVED
}

enum ProposalTechnicalReviewDecision {
  APPROVED
  CHANGES_REQUIRED
}

enum CommercialApprovalDecision {
  APPROVED
  REJECTED
}

enum ProposalWorkflowStage {
  PREPARATION
  TECHNICAL
  COMMERCIAL
  APPROVAL
  SENT
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  createdBy String   @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  updatedBy String   @db.Uuid
  users     User[]

  @@index([active])
  @@map("departments")
}

model User {
  id                             String                            @id @default(uuid()) @db.Uuid
  entraObjectId                  String                            @unique @db.Uuid
  displayName                    String                            @db.VarChar(160)
  email                          String                            @unique @db.VarChar(254)
  status                         UserStatus                        @default(ACTIVE)
  teamsProvisioningStatus        TeamsProvisioningStatus           @default(PENDING)
  teamsProvisioningAttempts      Int                               @default(0)
  teamsProvisioningLastAttemptAt DateTime?                         @db.Timestamptz(6)
  teamsProvisionedAt             DateTime?                         @db.Timestamptz(6)
  teamsProvisioningErrorCode     String?                           @db.VarChar(80)
  isMaster                       Boolean                           @default(false)
  isOwner                        Boolean                           @default(false)
  departmentId                   String?                           @db.Uuid
  department                     Department?                       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  profileMemberships             UserProfile[]
  ownedOpportunities             Opportunity[]                     @relation("OpportunityOwner")
  opportunityChanges             OpportunityHistory[]              @relation("OpportunityChangedBy")
  requirementResponsibilities    TenderRequirement[]               @relation("RequirementResponsible")
  requirementChanges             RequirementHistory[]              @relation("RequirementChangedBy")
  deadlineResponsibilities       TenderDeadline[]                  @relation("DeadlineResponsible")
  deadlineConfirmations          TenderDeadline[]                  @relation("DeadlineConfirmedBy")
  deadlineChanges                DeadlineHistory[]                 @relation("DeadlineChangedBy")
  calendarEventResponsibilities  CalendarEvent[]                   @relation("CalendarEventResponsible")
  analysisAssignments            RequirementAnalysis[]             @relation("AnalysisAssignee")
  analysisDecisions              RequirementAnalysis[]             @relation("AnalysisDecidedBy")
  analysisChanges                AnalysisHistory[]                 @relation("AnalysisChangedBy")
  ownedDocuments                 ManagedDocument[]                 @relation("DocumentOwner")
  technicalExperiences           ExecutedContract[]                @relation("TechnicalExperienceOwner")
  technicalExperienceChanges     TechnicalExperienceHistory[]      @relation("TechnicalExperienceChangedBy")
  technicalEvidenceRecords       TechnicalEvidence[]               @relation("TechnicalEvidenceCreatedBy")
  professionalRecords            Professional[]                    @relation("ProfessionalCreatedBy")
  professionalChanges            ProfessionalHistory[]             @relation("ProfessionalChangedBy")
  professionalLinks              ProfessionalLink[]                @relation("ProfessionalLinkCreatedBy")
  complianceMatrixChanges        ComplianceMatrixHistory[]         @relation("ComplianceMatrixChangedBy")
  complianceResponsibilities     ComplianceItemAssessment[]        @relation("ComplianceAssessmentResponsible")
  complianceValidations          ComplianceItemAssessment[]        @relation("ComplianceAssessmentValidatedBy")
  complianceExports              ComplianceMatrixExport[]          @relation("ComplianceExportedBy")
  proposalChanges                ProposalHistory[]                 @relation("ProposalChangedBy")
  proposalSectionAssignments     ProposalTechnicalSection[]        @relation("ProposalSectionResponsible")
  proposalSectionChanges         ProposalTechnicalSectionHistory[] @relation("ProposalSectionChangedBy")
  supportTicketsReported         SupportTicket[]                   @relation("SupportReportedBy")
  supportTicketsAssigned         SupportTicket[]                   @relation("SupportAssignedTo")
  supportTicketsResolved         SupportTicket[]                   @relation("SupportResolvedBy")
  supportDecisions               SupportTicketDecision[]           @relation("SupportDecidedBy")
  supportUpdates                 SupportTicketUpdate[]             @relation("SupportUpdatedBy")
  accessRequestsMade             UserAccessRequest[]               @relation("AccessRequestRequestedBy")
  accessRequestsDecided          UserAccessRequest[]               @relation("AccessRequestDecidedBy")
  accessRequestsTargeted         UserAccessRequest[]               @relation("AccessRequestTargetUser")
  intelligenceOutboxEvents       NotificationOutboxEvent[]         @relation("IntelligenceNotificationRecipient")
  intelligenceNotifications      UserNotification[]
  createdAt                      DateTime                          @default(now()) @db.Timestamptz(6)
  createdBy                      String                            @db.Uuid
  updatedAt                      DateTime                          @updatedAt @db.Timestamptz(6)
  updatedBy                      String                            @db.Uuid
  archivedAt                     DateTime?                         @db.Timestamptz(6)
  archivedBy                     String?                           @db.Uuid

  @@index([departmentId, status])
  @@index([isOwner, status])
  @@index([teamsProvisioningStatus, status])
  @@index([archivedAt])
  @@index([displayName])
  @@map("users")
}

model UserAccessRequest {
  id            String                  @id @default(uuid()) @db.Uuid
  action        UserAccessRequestAction
  status        UserAccessRequestStatus @default(PENDING)
  requestedById String                  @db.Uuid
  requestedBy   User                    @relation("AccessRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  targetUserId  String?                 @db.Uuid
  targetUser    User?                   @relation("AccessRequestTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  payload       Json
  decisionNote  String?                 @db.VarChar(1000)
  decidedById   String?                 @db.Uuid
  decidedBy     User?                   @relation("AccessRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime?               @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([targetUserId])
  @@map("user_access_requests")
}

model Customer {
  id                 String                      @id @default(uuid()) @db.Uuid
  name               String                      @db.VarChar(200)
  identifiers        Json?
  active             Boolean                     @default(true)
  opportunities      Opportunity[]
  paymentAssessments CustomerPaymentAssessment[]
  createdAt          DateTime                    @default(now()) @db.Timestamptz(6)
  createdBy          String                      @db.Uuid
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(6)
  updatedBy          String                      @db.Uuid

  @@index([name])
  @@index([active])
  @@map("customers")
}

model ContractingAuthority {
  id                 String                      @id @default(uuid()) @db.Uuid
  name               String                      @db.VarChar(200)
  sphere             String?                     @db.VarChar(80)
  locality           String?                     @db.VarChar(160)
  identifiers        Json?
  active             Boolean                     @default(true)
  opportunities      Opportunity[]
  tenders            Tender[]
  paymentAssessments CustomerPaymentAssessment[]
  createdAt          DateTime                    @default(now()) @db.Timestamptz(6)
  createdBy          String                      @db.Uuid
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(6)
  updatedBy          String                      @db.Uuid

  @@index([name])
  @@index([active])
  @@map("contracting_authorities")
}

model Opportunity {
  id                     String                        @id @default(uuid()) @db.Uuid
  code                   String                        @unique @db.VarChar(50)
  origin                 OpportunityOrigin
  subject                String?                       @db.Text
  customerId             String?                       @db.Uuid
  customer               Customer?                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractingAuthorityId String?                       @db.Uuid
  contractingAuthority   ContractingAuthority?         @relation(fields: [contractingAuthorityId], references: [id], onDelete: Restrict)
  estimatedValue         Decimal?                      @db.Decimal(19, 4)
  currency               String?                       @db.Char(3)
  valueSource            String?                       @db.VarChar(300)
  publishedAt            DateTime?                     @db.Timestamptz(6)
  deliveryAt             DateTime?                     @db.Timestamptz(6)
  datesSource            String?                       @db.VarChar(300)
  datesTimeZone          String?                       @db.VarChar(80)
  ownerId                String?                       @db.Uuid
  owner                  User?                         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status                 OpportunityStatus             @default(DRAFT)
  closureReasonCode      String?                       @db.VarChar(80)
  closureJustification   String?                       @db.VarChar(1000)
  closedAt               DateTime?                     @db.Timestamptz(6)
  version                Int                           @default(1)
  history                OpportunityHistory[]
  tenders                Tender[]
  proposals              Proposal[]
  intelligenceAnalyses   OpportunityAnalysis[]
  financialAssessments   FinancialCapacityAssessment[]
  notificationEvents     NotificationOutboxEvent[]
  calendarEvents         CalendarEvent[]
  createdAt              DateTime                      @default(now()) @db.Timestamptz(6)
  createdBy              String                        @db.Uuid
  updatedAt              DateTime                      @updatedAt @db.Timestamptz(6)
  updatedBy              String                        @db.Uuid

  @@index([status, deliveryAt])
  @@index([ownerId, status])
  @@index([customerId, status])
  @@index([contractingAuthorityId, status])
  @@map("opportunities")
}

model OpportunityCodeCounter {
  year       Int      @id
  lastNumber Int
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@map("opportunity_code_counters")
}

model CalendarEvent {
  id             String              @id @default(uuid()) @db.Uuid
  title          String              @db.VarChar(200)
  description    String?             @db.VarChar(2000)
  startAt        DateTime            @db.Timestamptz(6)
  endAt          DateTime?           @db.Timestamptz(6)
  allDay         Boolean             @default(false)
  responsibleId  String              @db.Uuid
  responsible    User                @relation("CalendarEventResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  opportunityId  String?             @db.Uuid
  opportunity    Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  proposalId     String?             @db.Uuid
  proposal       Proposal?           @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  tenderId       String?             @db.Uuid
  tender         Tender?             @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  status         CalendarEventStatus @default(SCHEDULED)
  category       CalendarEventCategory @default(MEETING)
  externalId     String?             @db.VarChar(200)
  externalSource String?             @db.VarChar(40)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  createdBy      String              @db.Uuid
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  updatedBy      String              @db.Uuid

  @@index([responsibleId, startAt])
  @@index([startAt])
  @@index([opportunityId])
  @@map("calendar_events")
}

model IntelligencePolicy {
  id                String                      @id @default(uuid()) @db.Uuid
  policyKey         String                      @db.Uuid
  version           Int
  previousVersionId String?                     @db.Uuid
  previousVersion   IntelligencePolicy?         @relation("IntelligencePolicyChain", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions      IntelligencePolicy[]        @relation("IntelligencePolicyChain")
  code              String                      @db.VarChar(80)
  name              String                      @db.VarChar(200)
  purpose           String                      @db.VarChar(1000)
  dimensions        Json
  weights           Json
  thresholds        Json
  impedimentRules   Json
  authorizedSources Json
  coverageMinimum   Decimal                     @db.Decimal(5, 2)
  effectiveFrom     DateTime                    @db.Date
  changeReason      String                      @db.VarChar(1000)
  approval          IntelligencePolicyApproval?
  analyses          OpportunityAnalysis[]
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  createdBy         String                      @db.Uuid
  correlationId     String                      @db.Uuid

  @@unique([policyKey, version])
  @@index([code, effectiveFrom])
  @@index([previousVersionId])
  @@map("intelligence_policies")
}

model IntelligencePolicyApproval {
  id            String             @id @default(uuid()) @db.Uuid
  policyId      String             @unique @db.Uuid
  policy        IntelligencePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  note          String             @db.VarChar(1000)
  approvedAt    DateTime           @db.Timestamptz(6)
  approvedBy    String             @db.Uuid
  correlationId String             @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)

  @@index([approvedAt])
  @@map("intelligence_policy_approvals")
}

model OpportunityAnalysis {
  id                 String                        @id @default(uuid()) @db.Uuid
  opportunityId      String                        @db.Uuid
  opportunity        Opportunity                   @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  policyId           String                        @db.Uuid
  policy             IntelligencePolicy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  version            Int
  type               OpportunityAnalysisType
  status             OpportunityAnalysisStatus     @default(QUEUED)
  inputHash          String                        @db.Char(64)
  score              Decimal?                      @db.Decimal(7, 4)
  coverage           Decimal?                      @db.Decimal(7, 4)
  confidence         Decimal?                      @db.Decimal(7, 4)
  recommendation     IntelligenceRecommendation?
  executiveSummary   String?                       @db.Text
  requestedAt        DateTime                      @default(now()) @db.Timestamptz(6)
  requestedBy        String                        @db.Uuid
  startedAt          DateTime?                     @db.Timestamptz(6)
  completedAt        DateTime?                     @db.Timestamptz(6)
  correlationId      String                        @db.Uuid
  dimensions         AnalysisDimensionResult[]
  evidences          AnalysisEvidence[]
  pendingItems       AnalysisPendingItem[]
  impediments        CriticalImpediment[]
  decisions          OpportunityAnalysisDecision[]
  climateStudy       ClimateStudy?
  routeStudy         RouteStudy?
  financialStudy     OpportunityFinancialStudy?
  notificationEvents NotificationOutboxEvent[]

  @@unique([opportunityId, version])
  @@unique([opportunityId, policyId, inputHash])
  @@index([opportunityId, status, requestedAt])
  @@index([policyId])
  @@index([correlationId])
  @@map("opportunity_analyses")
}

model AnalysisDimensionResult {
  id            String                  @id @default(uuid()) @db.Uuid
  analysisId    String                  @db.Uuid
  analysis      OpportunityAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  perspective   IntelligencePerspective
  dimension     String                  @db.VarChar(120)
  status        AnalysisDimensionStatus
  score         Decimal?                @db.Decimal(7, 4)
  weight        Decimal                 @db.Decimal(7, 4)
  confidence    Decimal                 @db.Decimal(7, 4)
  summary       String                  @db.Text
  facts         Json
  calculations  Json
  inferences    Json
  risks         Json
  method        String                  @db.VarChar(160)
  methodVersion String                  @db.VarChar(80)
  resultHash    String                  @db.Char(64)
  evidences     AnalysisEvidence[]
  pendingItems  AnalysisPendingItem[]
  createdAt     DateTime                @default(now()) @db.Timestamptz(6)

  @@unique([analysisId, perspective, dimension])
  @@index([analysisId, perspective])
  @@map("analysis_dimension_results")
}

model AnalysisEvidence {
  id                String                   @id @default(uuid()) @db.Uuid
  analysisId        String                   @db.Uuid
  analysis          OpportunityAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  dimensionResultId String?                  @db.Uuid
  dimensionResult   AnalysisDimensionResult? @relation(fields: [dimensionResultId], references: [id], onDelete: Restrict)
  sourceType        String                   @db.VarChar(80)
  sourceId          String?                  @db.VarChar(160)
  sourceVersion     String?                  @db.VarChar(80)
  sourceHash        String?                  @db.Char(64)
  locator           String?                  @db.VarChar(500)
  excerpt           String?                  @db.Text
  referenceDate     DateTime?                @db.Timestamptz(6)
  obtainedAt        DateTime                 @default(now()) @db.Timestamptz(6)
  accessLevel       String                   @db.VarChar(80)
  evidenceHash      String                   @db.Char(64)

  @@unique([analysisId, evidenceHash])
  @@index([dimensionResultId])
  @@index([sourceType, sourceId])
  @@map("analysis_evidences")
}

model AnalysisPendingItem {
  id                  String                   @id @default(uuid()) @db.Uuid
  analysisId          String                   @db.Uuid
  analysis            OpportunityAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  dimensionResultId   String?                  @db.Uuid
  dimensionResult     AnalysisDimensionResult? @relation(fields: [dimensionResultId], references: [id], onDelete: Restrict)
  description         String                   @db.VarChar(1000)
  reason              String                   @db.VarChar(1000)
  requiredInformation String                   @db.VarChar(1000)
  responsibleId       String?                  @db.Uuid
  dueAt               DateTime?                @db.Timestamptz(6)
  status              AnalysisPendingStatus    @default(OPEN)
  response            String?                  @db.Text
  confirmedAt         DateTime?                @db.Timestamptz(6)
  confirmedBy         String?                  @db.Uuid
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)

  @@index([analysisId, status, dueAt])
  @@index([responsibleId, status])
  @@map("analysis_pending_items")
}

model CriticalImpediment {
  id               String                   @id @default(uuid()) @db.Uuid
  analysisId       String                   @db.Uuid
  analysis         OpportunityAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  type             CriticalImpedimentType
  status           CriticalImpedimentStatus @default(OPEN)
  ruleCode         String                   @db.VarChar(120)
  severity         String                   @db.VarChar(40)
  summary          String                   @db.VarChar(1000)
  evidenceSnapshot Json
  detectedAt       DateTime                 @default(now()) @db.Timestamptz(6)

  @@unique([analysisId, type])
  @@index([status, detectedAt])
  @@map("critical_impediments")
}

model OpportunityAnalysisDecision {
  id                     String                      @id @default(uuid()) @db.Uuid
  analysisId             String                      @db.Uuid
  analysis               OpportunityAnalysis         @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  decision               OpportunityDecisionType
  justification          String                      @db.VarChar(2000)
  observedRecommendation IntelligenceRecommendation?
  observedImpediments    Json
  decidedAt              DateTime                    @default(now()) @db.Timestamptz(6)
  decidedBy              String                      @db.Uuid
  correlationId          String                      @db.Uuid

  @@index([analysisId, decidedAt])
  @@index([decidedBy, decidedAt])
  @@map("opportunity_analysis_decisions")
}

model ClimateStudy {
  id                String              @id @default(uuid()) @db.Uuid
  analysisId        String              @unique @db.Uuid
  analysis          OpportunityAnalysis @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  provider          String              @db.VarChar(120)
  providerRequestId String?             @db.VarChar(160)
  locationLabel     String              @db.VarChar(255)
  latitude          Decimal             @db.Decimal(10, 7)
  longitude         Decimal             @db.Decimal(10, 7)
  workStart         DateTime            @db.Date
  workEnd           DateTime            @db.Date
  historyStart      DateTime            @db.Date
  historyEnd        DateTime            @db.Date
  station           Json?
  monthlySeries     Json
  sourceMetadata    Json
  dataCoverage      Decimal             @db.Decimal(7, 4)
  responseHash      String              @db.Char(64)
  retrievedAt       DateTime            @db.Timestamptz(6)
  methodVersion     String              @db.VarChar(80)
  resultHash        String              @db.Char(64)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  @@index([provider, retrievedAt])
  @@index([latitude, longitude])
  @@map("climate_studies")
}

model OperationalBase {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique @db.VarChar(50)
  name          String             @db.VarChar(200)
  locality      String             @db.VarChar(200)
  latitude      Decimal            @db.Decimal(10, 7)
  longitude     Decimal            @db.Decimal(10, 7)
  source        String             @db.VarChar(500)
  active        Boolean            @default(true)
  version       Int                @default(1)
  selectedRoute RouteStudy[]       @relation("SelectedOperationalBase")
  routeDetails  RouteDetailStudy[]
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  createdBy     String             @db.Uuid
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  updatedBy     String             @db.Uuid

  @@index([active, name])
  @@map("operational_bases")
}

model RouteStudy {
  id                String              @id @default(uuid()) @db.Uuid
  analysisId        String              @unique @db.Uuid
  analysis          OpportunityAnalysis @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  provider          String              @db.VarChar(120)
  providerRequestId String?             @db.VarChar(160)
  destinationLabel  String              @db.VarChar(255)
  destinationLat    Decimal             @db.Decimal(10, 7)
  destinationLng    Decimal             @db.Decimal(10, 7)
  travelMode        String              @db.VarChar(40)
  alternatives      Json
  selectedBaseId    String?             @db.Uuid
  selectedBase      OperationalBase?    @relation("SelectedOperationalBase", fields: [selectedBaseId], references: [id], onDelete: Restrict)
  selectionStatus   String              @db.VarChar(40)
  requestHash       String              @db.Char(64)
  responseHash      String              @db.Char(64)
  retrievedAt       DateTime            @db.Timestamptz(6)
